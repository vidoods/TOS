# TradeOS — Шаблон конфигурации окружения (Пример для Git)
# Скопируйте этот файл в .env и укажите ваши реальные значения: cp .env.example .env

# База данных
DB_HOST=127.0.0.1
DB_NAME=tradeos_db
DB_USER=root
DB_PASS=

# Почтовый сервис Resend
RESEND_API_KEY=
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=TradeOS
APP_URL=https://yourdomain.com

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth_google.php
