# TradeOS — Шаблон конфигурации окружения (Пример для Git)
# Скопируйте этот файл в .env и укажите ваши реальные значения: cp .env.example .env

# База данных
DB_HOST=127.0.0.1
DB_NAME=tradeos_db
DB_USER=root
DB_PASS=

# Почтовый сервис SMTP (например, ukr.net)
SMTP_HOST=smtp.ukr.net
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=wrkspace@ukr.net
SMTP_PASS=
MAIL_FROM=wrkspace@ukr.net
MAIL_FROM_NAME=TradeOS
APP_URL=https://yourdomain.com

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth_google.php
